# ==== Database ====
DB_NAME=cbt
DB_USER=cbt
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# ==== App ====
# Port publik yang dipakai Nginx Proxy Manager untuk meneruskan traffic
APP_PORT=8080

# Ganti dengan string acak panjang (minimal 32 karakter)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Bind JWT ke IP selain User-Agent. Aktifkan hanya jika IP peserta stabil.
BIND_IP=false

# Rate limit login (proteksi brute force/DoS).
RATE_LIMIT_ENABLED=true
LOGIN_IP_LIMIT=300
LOGIN_USER_LIMIT=5
LOGIN_WINDOW_SECONDS=300

# Backup sistem (panel admin).
BACKUP_ENABLED=true
BACKUP_RETENTION_COUNT=10
BACKUP_MAX_UPLOAD_MB=1024

# Percayai header X-Forwarded-For dari reverse proxy (Nginx Proxy Manager).
TRUST_PROXY=true

# Seed data demo (admin/student + contoh soal AIKEN & GIFT) saat DB kosong
SEED_ON_START=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_STUDENT_USERNAME=siswa
SEED_STUDENT_PASSWORD=siswa12345

# URL publik (opsional, untuk referensi absolut)
PUBLIC_BASE_URL=
